{
  "name": "@workspace/db",
  "version": "1.0.0",
  "description": "Database package",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules .turbo generated",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --skip-generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && ts-node --esm prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:studio": "prisma studio",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check . && prisma format --check"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/node": "^24.7.1",
    "prettier": "^3.6.2",
    "prisma": "^6.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0"
  }
}
